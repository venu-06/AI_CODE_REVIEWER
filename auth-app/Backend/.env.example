# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5000

# Database Configuration (MongoDB)
MONGO_URI=mongodb://localhost:27017/authapp

# Authentication Security
JWT_SECRET=your_jwt_secret_key_here

# Email Verification & SMTP Credentials
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# AI Service Provider Credentials (Groq / OpenAI)
AI_PROVIDER=groq
AI_API_KEY=your_ai_api_key_here
AI_MODEL=openai/gpt-oss-120b

# Online Compiler Service (OneCompiler API)
ONECOMPILER_API_KEY=your_onecompiler_api_key_here
